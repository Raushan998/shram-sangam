<% if flash[:alert].present? %>
  <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center justify-content-between px-3 py-2 shadow-sm rounded-3 small" role="alert" style="max-width: 420px; margin: auto;">
    <div class="me-3">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      <%= flash[:alert] %>
    </div>
    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>

<%= form_with(model: work, local: true, data: { turbo: false }, html: { class: "needs-validation", novalidate: true }) do |f| %>
  <!-- Basic Fields -->
  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <!-- Work Type and Category -->
  <div class="row mb-3">
    <div class="col-md-6">
      <%= f.label :work_type, class: "form-label" %>
      <%= f.select :work_type, Work.work_types.keys.map { |k| [k.humanize, k] }, { prompt: "Select type" }, class: "form-select", required: true %>
    </div>
    <div class="col-md-6">
      <%= f.label :category, class: "form-label" %>
      <%= f.select :category, Work.categories.keys.map { |k| [k.humanize, k] }, { prompt: "Select category" }, class: "form-select" %>
    </div>
  </div>

  <!-- Budget Fields -->
  <div class="row mb-3">
    <div class="col-md-4">
      <%= f.label :budget_type, class: "form-label" %>
      <%= f.select :budget_type, Work.budget_types.keys.map { |k| [k.humanize, k] }, { prompt: "Budget type" }, class: "form-select", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :budget_amount, class: "form-label" %>
      <%= f.number_field :budget_amount, class: "form-control", step: "0.01" %>
    </div>
    <div class="col-md-4">
      <%= f.label :required_workers, class: "form-label" %>
      <%= f.number_field :required_workers, class: "form-control" %>
    </div>
  </div>

  <!-- Contact Info -->
  <div class="row">
    <div class="col-md-4">
      <%= f.label :contact_person_name, class: "form-label" %>
      <%= f.text_field :contact_person_name, class: "form-control", required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :contact_person_phone_number, class: "form-label" %>
      <%= f.text_field :contact_person_phone_number, class: "form-control", required: true %>
    </div>
  </div>

  <br>

  <!-- Post Visibility -->
  <div class="mb-3">
    <span class="form-label d-block">Post Visibility</span>
    <% Work.post_visibilities.keys.each do |vis| %>
      <div class="form-check form-check-inline">
        <%= f.radio_button :post_visibility, vis, class: "form-check-input", id: "post_visibility_#{vis}" %>
        <%= f.label "post_visibility_#{vis}", vis.humanize, class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <!-- Addresses Section -->
  <div class="mb-4" data-controller="address">
    <h5 class="form-label">Addresses</h5>

    <div id="addresses-container" data-address-target="container">
      <%= f.fields_for :addresses do |address_form| %>
        <div class="address-form border p-3 mb-3 rounded">
          <%= address_form.hidden_field :_destroy %>
          <div class="row">
            <div class="col-md-12 mb-3">
              <%= address_form.label :street, class: "form-label" %>
              <%= address_form.text_field :street, class: "form-control", placeholder: "Street address" %>
            </div>
            <div class="col-md-12 mb-3">
              <%= address_form.label :landmark, class: "form-label" %>
              <%= address_form.text_field :landmark, class: "form-control", placeholder: "Landmark" %>
            </div>
            <div class="col-md-4 mb-3">
              <%= address_form.label :city, class: "form-label" %>
              <%= address_form.text_field :city, class: "form-control", placeholder: "City" %>
            </div>
            <div class="col-md-4 mb-3">
              <%= address_form.label :state, class: "form-label" %>
              <%= address_form.text_field :state, class: "form-control", placeholder: "State" %>
            </div>
            <div class="col-md-4 mb-3">
              <%= address_form.label :postal_code, class: "form-label" %>
              <%= address_form.text_field :postal_code, class: "form-control", placeholder: "Postal Code" %>
            </div>
            <div class="col-md-8 mb-3">
              <%= address_form.label :country, class: "form-label" %>
              <%= address_form.text_field :country, class: "form-control", placeholder: "Country" %>
            </div>
            <div class="col-md-4 mb-3 d-flex align-items-end">
              <button type="button" class="btn btn-sm btn-outline-danger" data-action="address#remove">Remove</button>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <button type="button" class="btn btn-outline-secondary" data-action="address#add">Add Another Address</button>
  </div>

  <%= f.submit "Submit", class: "btn btn-primary" %>
<% end %>
