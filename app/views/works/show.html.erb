<% address = @work.addresses.first %>
<% masked_phone = @work.contact_person_phone_number&.gsub(/.(?=..)/, '*') %>

<div class="container my-5">
  <div class="mb-3">
    <%= link_to works_path, class: "text-decoration-none small" do %>
      <i class="bi bi-arrow-left"></i>&nbsp;Back to all works
    <% end %>
  </div>

  <h1 class="mb-2 fw-semibold"><%= @work.title.presence || "Untitled work" %></h1>
  <div class="d-flex flex-wrap gap-2 mb-4">
    <span class="badge bg-primary"><%= @work.category&.humanize || "Uncategorized" %></span>
    <span class="badge bg-secondary"><%= @work.work_type&.humanize %></span>
    <span class="badge bg-info text-dark">
      <%= pluralize(@work.required_workers || 1, "worker") %> needed
    </span>
  </div>

  <div class="row gy-4">
    <div class="col-lg-8">
      <section class="mb-5">
        <h4 class="h5">Job description</h4>
        <p class="fs-6 lh-base">
          <%= simple_format(@work.description.presence || "No description provided.") %>
        </p>
      </section>

      <section class="mb-5">
        <h4 class="h5">Location</h4>
        <% if address %>
          <p class="mb-0">
            <i class="bi bi-geo-alt-fill me-1"></i>
            <%= [address.city, address.street.presence,
                 address.landmark.presence, address.state,
                 address.country, address.postal_code].compact.join(", ") %>
          </p>
        <% else %>
          <p class="mb-0"><i class="bi bi-globe2 me-1"></i> Remote / Unspecified</p>
        <% end %>
      </section>

      <section class="mb-5">
        <h4 class="h5">Budget</h4>
        <p class="mb-0">
          <% if @work.budget_amount.present? %>
            <%= @work.budget_type&.humanize %> -
            <strong><%= number_to_currency(@work.budget_amount) %></strong>
          <% else %>
            <%= @work.budget_type&.humanize || "N/A" %>
          <% end %>
        </p>
      </section>
    </div>

    <div class="col-lg-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-3">Project overview</h5>

          <dl class="row small mb-4">
            <dt class="col-6 text-muted">Budget</dt>
            <dd class="col-6 text-end">
              <% if @work.budget_amount.present? %>
                <%= number_to_currency(@work.budget_amount) %>
              <% else %>
                —
              <% end %>
            </dd>

            <dt class="col-6 text-muted">Type</dt>
            <dd class="col-6 text-end"><%= @work.work_type&.humanize %></dd>

            <dt class="col-6 text-muted">Category</dt>
            <dd class="col-6 text-end"><%= @work.category&.humanize || "—" %></dd>
            <% if @work.contact_person_name.present? %>
              <dt class="col-6 text-muted">Contact</dt>
              <dd class="col-6 text-end">
                <%= @work.contact_person_name %><br>
                <% if @work.contact_person_phone_number.present? %>
                  <button type="button" id="call-btn" class="btn btn-outline-primary btn-sm ms-2" data-phone="<%= @work.contact_person_phone_number %>">
                    <i class="bi bi-telephone"></i> <span id="masked-phone"><%= masked_phone %></span>
                  </button>
                <% end %>
              </dd>
            <% end %>
          </dl>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    function attachCallButton() {
      const btn = document.getElementById('call-btn');
      if (!btn) return;
      btn.addEventListener('click', function() {
        const phone = this.dataset.phone;
        window.location.href = `tel:${phone}`;
      });
    }
    document.addEventListener('turbo:load', attachCallButton);
    document.addEventListener('DOMContentLoaded', attachCallButton);
</script>
