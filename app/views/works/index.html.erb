<%= render 'layouts/navbar'%>
<div class="container mt-5">
    <div class="row">
      <div class="col-md-3">
        <h5 class="mb-3">Filter Works</h5>
        <%= form_with url: works_path, method: :get, local: true do |f| %>
          <div class="mb-3">
            <%= f.label :work_type, "Work Type", class: "form-label" %>
            <%= f.select :work_type, Work.work_types.keys.map { |k| [k.humanize, k] }, 
                         { include_blank: "All" }, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :category, "Category", class: "form-label" %>
            <%= f.select :category, Work.categories.keys.map { |k| [k.humanize, k] }, 
                         { include_blank: "All" }, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= f.label :city, "City", class: "form-label" %>
            <%= f.select :city, Address.pluck(:city).uniq.map {|k| [k.humanize, k]},
                                { include_blank: "All" }, class: "form-select" %>
          </div>
          <%= f.submit "Apply Filters", class: "btn btn-primary w-100" %>
        <% end %>
      </div>
      
      <div class="col-md-9">
        <% if @works.any? %>
          <% @works.each do |work| %>
            <% address = work.addresses.first %>
            <div class="card mb-4 shadow-sm">
              <div class="card-body">
                <h5 class="card-title mb-1"><%= work.title %></h5>
                <p class="text-muted small mb-2">
                  <% if address %>
                    <i class="bi bi-geo-alt-fill"></i>
                    <%= [ address.city, address.street.presence, address.landmark.presence, 
                          address.state, address.country, address.postal_code ].compact.join(', ') %>
                  <% else %>
                    <i class="bi bi-globe2"></i>Unspecified
                  <% end %>
                </p>
                <p class="card-text"><%= truncate(work.description, length: 140) %></p>
                <div class="d-flex flex-wrap gap-2 small mb-3">
                  <span class="badge bg-secondary"><%= work.work_type&.humanize %></span>
                  <% if work.category? %>
                    <span class="badge bg-primary"><%= work.category&.humanize %></span>
                  <% end %>
                  <span class="badge bg-info text-dark">
                    <%= pluralize(work.required_workers, "worker") %>
                  </span>
                  <span class="badge bg-success">
                    <%= work.budget_type&.humanize %> · <%= number_to_currency(work.budget_amount) %>
                  </span>
                </div>
                <%= link_to "View details", work_path(work), class: "btn btn-sm btn-outline-primary" %>
              </div>
            </div>
          <% end %>
          <div class="card">
            <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-center py-3 px-4">
              <div class="text-muted mb-3 mb-md-0">
                Showing <span class="fw-semibold"><%= @pagy.from %>-<%= @pagy.to %></span> 
                of <span class="fw-semibold"><%= @pagy.count %></span> works
              </div>
              <div class="d-flex align-items-center">
                <% local_opts = {size: 5} %>
                <%== pagy_bootstrap_nav(@pagy, **local_opts) if @pagy.pages > 1 %>
                <% if @pagy.count > 10 %>
                  <button class="btn btn-sm btn-outline-primary ms-3" 
                          onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                    <i class="bi bi-arrow-up me-1"></i>Back to top
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="text-center py-5">
            <i class="bi bi-search display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No works found</h4>
            <p class="text-muted">Try adjusting your filters or check back later.</p>
          </div>
        <% end %>
      </div>
    </div>
</div>