<%= render 'layouts/navbar'%>
<%= render 'lead' %>
<div class="container-fluid py-4">
  <%= render 'filter'%>
  <turbo-frame id="workers">
    <div class="card shadow rounded-3 border-0">
      <div class="card-header bg-dark-subtle text-black py-3">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="mb-0 fw-bold">
            <i class="bi bi-people me-2"></i>Workers Directory
          </h4>
          <span class="badge bg-light text-black fs-6 fw-semibold px-3 shadow-sm">
            <%= @pagy.count %> workers found
          </span>
        </div>
      </div>
      
      <% if @workers.empty? %>
        <div class="card-body text-center py-5">
          <div class="py-5">
            <div class="display-1 text-secondary mb-3">
              <i class="bi bi-search"></i>
            </div>
            <h4 class="text-secondary mb-3">No workers match your search criteria</h4>
            <p class="text-muted mb-4">
              Try adjusting your filters or exploring other options
            </p>
            <%= link_to "View All Workers", workers_path, 
                class: "btn btn-transparent px-4 py-2", 
                data: { turbo_frame: '_top' } %>
          </div>
        </div>
      <% else %>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="workersTable">
              <thead class="table-light">
                <tr>
                  <th class="ps-4 py-3">
                    <%= sort_link(@q, :name, "<span class='fw-semibold'>Name</span>".html_safe, 
                        { class: "text-decoration-none text-dark d-flex align-items-center" }) %>
                  </th>
                  <th class="py-3">
                    <%= sort_link(@q, :work_type, "<span class='fw-semibold'>Expertise</span>".html_safe, 
                        { class: "text-decoration-none text-dark" }) %>
                  </th>
                  <th class="py-3">
                    <%= sort_link(@q, :city, "<span class='fw-semibold'>Location</span>".html_safe, 
                        { class: "text-decoration-none text-dark" }) %>
                  </th>
                  <th class="py-3 pe-4">
                    <span class="fw-semibold">Contact</span>
                  </th>
                </tr>
              </thead>
              <tbody class="border-top-0">
                <% @workers.each do |worker| %>
                  <tr>
                    <td class="ps-4">
                      <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-gradien text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; font-size: 1rem;">
                          <%= worker.name&.first&.upcase %>
                        </div>
                        <div class="fw-semibold">
                          <%= worker.name %>
                        </div>
                      </div>
                    </td>
                    <td>
                      <% work_type = worker.work_type&.downcase %>
                      <% case work_type %>
                      <% when 'plumber' %>
                        <span class="badge text-bg-primary">
                          <i class="bi bi-wrench me-1"></i> Plumber
                        </span>
                      <% when 'electrician' %>
                        <span class="badge text-bg-success">
                          <i class="bi bi-lightning-charge me-1"></i> Electrician
                        </span>
                      <% when 'building_contractor' %>
                        <span class="badge text-bg-warning text-dark">
                          <i class="bi bi-building me-1"></i> Building Contractor
                        </span>
                      <% when 'mason' %>
                        <span class="badge text-bg-info">
                          <i class="bi bi-hammer me-1"></i> Mason
                        </span>
                      <% when 'labor' %>
                        <span class="badge text-bg-danger">
                          <i class="bi bi-hammer me-1"></i> Labor
                        </span>
                      <% when 'carpenter' %>
                        <span class="badge bg-secondary">
                          <i class="bi bi-tools me-1"></i> Carpenter
                        </span>
                      <%when 'painter'%>
                         <span class="badge bg-warning text-dark">
                            <i class="bi bi-paint-bucket me-1"></i> Painter
                         </span>
                      <% else %>
                        <span class="badge bg-secondary"><%= worker.work_type&.titleize %></span>
                      <% end %>
                    </td>
                    <td>
                      <div class="d-flex align-items-start">
                        <i class="bi bi-geo-alt text-dark me-2 mt-1"></i>
                        <div>
                          <div class="fw-medium">
                            <%= worker.city.presence || "N/A" %><%= ", #{worker.state}" if worker.state.present? %>
                          </div>
                          <div class="small text-muted">
                            <%= [worker.addr1.presence, worker.addr2.presence].compact.join(', ') %>
                            <% if worker.pincode.present? %>
                              <span class="ms-1 badge bg-light text-secondary">
                                <%= worker.pincode %>
                              </span>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td class="pe-4">
                      <div class="d-flex flex-column">
                        <% if worker.phone_number.present? %>
                        <button data-controller="worker"
                                data-worker-phone-value="<%= worker.phone_number %>"
                                data-action="mouseover->worker#show mouseleave->worker#hide click->worker#call"
                                class="btn btn-outline-dark btn-sm mb-2 text-start fixed-size-btn">
                            <i class="bi bi-eye me-1"></i> <span class="button-text">Show Number</span>
                        </button>
                        <% else %>
                          <div class="text-muted small mb-2 py-1 px-2" style="min-height: 31px;">
                            <i class="bi bi-telephone-x me-1"></i> No phone available
                          </div>
                        <% end %>
                        
                        <% if worker.email.present? %>
                          <a href="mailto:<%= worker.email %>" class="btn btn-outline-secondary btn-sm text-start text-truncate" style="max-width: 200px;">
                            <i class="bi bi-envelope me-1"></i><span><%= worker.email %></span>
                          </a>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        
        <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-center py-3 px-4">
          <div class="text-muted mb-3 mb-md-0">
            Showing <span class="fw-semibold"><%= @pagy.from %>-<%= @pagy.to %></span> of <span class="fw-semibold"><%= @pagy.count %></span> workers
          </div>
          
          <div class="d-flex align-items-center">
            <% local_opts = {size: 5} # Explicitly set size as an integer %>
            <%== pagy_bootstrap_nav(@pagy, **local_opts) if @pagy.pages > 1 %>
            
            <% if @pagy.count > 10 %>
              <button class="btn btn-sm btn-outline-primary ms-3" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
                <i class="bi bi-arrow-up me-1"></i>Back to top
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </turbo-frame>
</div>