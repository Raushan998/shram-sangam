<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-3 mb-md-4">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="#">
      shram-sangam
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarContent">
      <div class="ms-auto d-flex">
        <button class="btn btn-light text-primary fw-bold" type="button" data-bs-toggle="modal" data-bs-target="#workerModal">
          <i class="bi bi-person-plus-fill me-1"></i>Are you a worker?
        </button>
      </div>
    </div>
  </div>
</nav>

<div class="modal fade" id="workerModal" tabindex="-1" aria-labelledby="workerModalLabel" aria-hidden="true" data-controller="worker">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title" id="workerModalLabel">Join Our Workers Network</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div data-worker-target="formContainer">
          <p class="mb-3">Enter your phone number below and we'll contact you with more information on how to join our workers network.</p>
          <div class="form-floating mb-3">
            <input type="tel" class="form-control" id="phoneNumber" placeholder="Enter your phone number" data-worker-target="phoneInput">
            <label for="phoneNumber"><i class="bi bi-telephone me-1"></i>Phone Number</label>
          </div>
          <button type="button" class="btn btn-primary w-100" data-action="click->worker#submit">
            <i class="bi bi-check-circle me-1"></i>Submit
          </button>
        </div>
        <div class="text-center py-4 d-none" data-worker-target="thankYouMessage">
          <div class="mb-3">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
          </div>
          <h4 class="mb-2">Thanks for believing in us!</h4>
          <p class="mb-4">We've received your information and will contact you soon.</p>
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid py-4">
  <div class="card shadow-sm mb-4 rounded-3 overflow-hidden" style="border: 1px solid #ADD8E6;">
    <div class="card-header bg-primary text-white py-3">
      <div class="d-flex justify-content-between align-items-center">
        <h4 class="mb-0 fw-bold">
          <i class="bi bi-search me-2"></i>Find Workers
        </h4>
        <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse" data-bs-target="#searchCollapse">
          <i class="bi bi-chevron-down"></i>
        </button>
      </div>
    </div>
    <div class="collapse show" id="searchCollapse">
      <div class="card-body bg-light">
        <%= search_form_for @q, url: workers_path, method: :get, html: { data: { turbo_frame: 'workers' } } do |f| %>
          <div class="row g-3">
            <div class="col-md-6 col-sm-12">
              <div class="form-floating">
                <%= f.select :work_type_eq, Worker.pluck(:work_type).uniq.compact.sort.map {|wt| [wt.titleize, wt]}, { include_blank: "All Types" }, class: "form-select shadow-sm" %>
                <label><i class="bi bi-briefcase me-1"></i>Work Type</label>
              </div>
            </div>
  
            <div class="col-md-6 col-sm-12">
              <div class="form-floating">
                <%= f.select :city_eq, Worker.pluck(:city).uniq.compact.sort, { include_blank: "All Cities" }, class: "form-select shadow-sm" %>
                <label><i class="bi bi-building me-1"></i>City</label>
              </div>
            </div>
            
            <div class="col-12 d-flex justify-content-end mt-4">
              <%= link_to workers_path, class: "btn btn-outline-secondary me-2", data: { turbo_frame: '_top' } do %>
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
              <% end %>
              <%= f.submit "Search", class: "btn btn-primary px-4" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  
  <!-- Results Card Wrapped in a Turbo Frame -->
  <turbo-frame id="workers">
    <div class="card shadow rounded-3 overflow-hidden" style="border: 1px solid #ADD8E6;">
      <div class="card-header bg-primary text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
          <h4 class="mb-0 fw-bold">
            <i class="bi bi-people me-2"></i>Workers Directory
          </h4>
          <span class="badge bg-light text-dark fs-6 fw-semibold rounded-pill px-3">
            <%= @workers.count %> workers found
          </span>
        </div>
      </div>
      
      <% if @workers.empty? %>
        <div class="card-body text-center py-5">
          <div class="empty-state py-4">
            <i class="bi bi-search text-secondary" style="font-size: 3rem;"></i>
            <h5 class="mt-3 text-secondary">No workers match your search criteria</h5>
            <p class="text-muted">
              Try adjusting your filters or <%= link_to "view all workers", workers_path, data: { turbo_frame: '_top' } %>
            </p>
          </div>
        </div>
      <% else %>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="workersTable">
              <thead class="table-light">
                <tr>
                  <th class="ps-3">
                    <%= sort_link(@q, :name, "Name", class: "text-decoration-none text-dark") %>
                  </th>
                  <th>
                    <%= sort_link(@q, :work_type, "Expertise", class: "text-decoration-none text-dark") %>
                  </th>
                  <th>
                    <%= sort_link(@q, :city, "Location", class: "text-decoration-none text-dark") %>
                  </th>
                  <th>Contact</th>
                </tr>
              </thead>
              <tbody>
                <% @workers.each do |worker| %>
                  <tr>
                    <td class="ps-3">
                      <div class="d-flex align-items-center">
                        <div class="bg-primary text-white me-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                          <%= worker.name&.first&.upcase %>
                        </div>
                        <div class="fw-semibold">
                          <%= worker.name %>
                        </div>
                      </div>
                    </td>
                    <td>
                      <% work_type = worker.work_type&.downcase %>
                      <% case work_type %>
                      <% when 'plumber' %>
                        <span class="badge" style="background-color: #007bff;">
                          <i class="bi bi-wrench me-1"></i> Plumber
                        </span>
                      <% when 'electrician' %>
                        <span class="badge" style="background-color: #28a745;">
                          <i class="bi bi-lightning-charge me-1"></i> Electrician
                        </span>
                      <% when 'building_contractor' %>
                        <span class="badge" style="background-color: #ffc107;">
                          <i class="bi bi-building me-1"></i> Building Contractor
                        </span>
                      <% when 'mason' %>
                        <span class="badge" style="background-color: #17a2b8;">
                          <i class="bi bi-hammer me-1"></i> Mason
                        </span>
                      <% when 'labor' %>
                        <span class="badge" style="background-color: #dc3545;">
                          <i class="bi bi-hammer me-1"></i> Labor
                        </span>
                      <% when 'carpenter' %>
                        <span class="badge" style="background-color: #6f42c1;">
                          <i class="bi bi-tools me-1"></i> Carpenter
                        </span>
                      <%when 'painter'%>
                         <span class="badge" style="background-color: #fd7e14;">
                            <i class="bi bi-paint-bucket me-1"></i> Painter
                         </span>
                      <% else %>
                        <span class="badge bg-secondary"><%= worker.work_type&.titleize %></span>
                      <% end %>
                    </td>
                    <td>
                      <div>
                        <i class="bi bi-geo-alt me-1"></i>
                        <%= [worker.addr1.presence, worker.addr2.presence, worker.city.presence, worker.state.presence].compact.join(', ') %>
                      </div>
                      <div class="small text-muted">
                        <%= worker.pincode %>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex flex-column">
                        <% if worker.phone_number.present? %>
                          <span data-controller="worker"
                                data-worker-phone-value="<%= worker.phone_number %>"
                                data-action="mouseover->worker#show mouseleave->worker#hide click->worker#call"
                                class="text-decoration-none">
                            <i class="bi bi-eye me-1"></i> Show Number
                           </span>
                        <% else %>
                          <span>Not Available</span>
                        <%end %>
                        <% if worker.email.present? %>
                          <a href="mailto:<%= worker.email %>" class="text-decoration-none small">
                            <i class="bi bi-envelope me-1"></i><%= worker.email %>
                          </a>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
        
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
          <div class="text-muted small">
            Showing <span class="fw-semibold"><%= @workers.count %></span> workers
          </div>
        </div>
      <% end %>
    </div>
  </turbo-frame>
</div>