<div class="container mt-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Worker Search</h4>
      </div>
      <div class="card-body">
        <%= search_form_for @q, url: workers_path, method: :get do |f| %>
          <div class="row g-3">
            <div class="col-md-3">
              <div class="form-floating">
                <%= f.select :work_type_eq, Worker.pluck(:work_type).uniq, { include_blank: "Select Work Type" }, class: "form-select" %>
                <%= f.label :work_type_eq, "Work Type" %>
              </div>
            </div>
  
            <div class="col-md-3">
              <div class="form-floating">
                <%= f.select :city_eq, Worker.pluck(:city).uniq, { include_blank: "Select City" }, class: "form-select" %>
                <%= f.label :city_cont, "City" %>
              </div>
            </div>
            
            <div class="col-md-6 d-flex align-items-end">
              <%= f.submit "Search", class: "btn btn-primary me-2" %>
              <%= link_to "Reset", workers_path, class: "btn btn-outline-secondary" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Workers List</h4>
        <span class="badge bg-light text-dark"><%= @workers.count %> workers found</span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover table-striped mb-0">
            <thead class="table-light">
              <tr>
                <th>Name</th>
                <th>Phone Number</th>
                <th>State</th>
                <th>City</th>
                <th>Pincode</th>
                <th>Work Type</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody>
              <% @workers.each do |worker| %>
                <tr>
                  <td><strong><%= worker.name %></strong></td>
                  <td><span class="text-primary"><%= worker.phone_number %></span></td>
                  <td><%= worker.state %></td>
                  <td><%= worker.city %></td>
                  <td><%= worker.pincode %></td>
                  <td><span class="badge bg-secondary"><%= worker.work_type %></span></td>
                  <td><a href="mailto:<%= worker.email %>"><%= worker.email %></a></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    
    <% if @workers.empty? %>
      <div class="alert alert-info mt-3">
        <i class="bi bi-info-circle me-2"></i> No workers found matching your criteria.
      </div>
    <% end %>
  </div>